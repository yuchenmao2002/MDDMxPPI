# ==========================================
# 1. HPC 任务脚本与集群日志 (PBS/Slurm)
# ==========================================
# 忽略 PBS/任务提交脚本
*.pbs
*.PBS
*.sub

# ==========================================
# 2. 数据目录结构保留
# ==========================================
# 忽略 data 目录下的所有内容，但保留目录本身
data/*
!data/.gitkeep

# 忽略 output 目录下的所有内容
output/*


# ==========================================
# 43. 常见编程语言生成文件 (Python)
# ==========================================
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.ipynb_checkpoints/
